# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube al repo (.gitignore).

# Servidor
PORT=4000
# URL donde corre el frontend (Mercado Pago vuelve a <FRONTEND_URL>/resultado después de pagar)
FRONTEND_URL=http://localhost:5173

# Autenticación: cualquier string largo y aleatorio (ej: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=

# Mercado Pago: Access Token de PRUEBA de la cuenta vendedora de test.
# Mercado Pago Developers > Tus integraciones > (app) > Credenciales de prueba. Empieza con APP_USR-
MP_ACCESS_TOKEN=

# Mail de confirmación con Gmail. Requiere verificación en 2 pasos y una "Contraseña de aplicación"
# (https://myaccount.google.com/apppasswords). Si se dejan vacíos, los mails se muestran por consola.
MAIL_USER=
MAIL_APP_PASSWORD=

# Mail real del usuario demo (visitante@ecoharmony.test / visitante123) para recibir la confirmación
USUARIO_DEMO_EMAIL=
