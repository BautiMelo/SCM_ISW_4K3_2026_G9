# Copiar este archivo como .env y completar los valores. El .env NUNCA se sube al repo.

# Servidor
PORT=4000
# URL donde corre el frontend (Mercado Pago vuelve acá después de pagar)
FRONTEND_URL=http://localhost:5173

# Autenticación (cualquier string largo y aleatorio)
JWT_SECRET=cambiar-por-un-secreto-largo

# Mercado Pago - Access Token de PRUEBA de la cuenta vendedora de test
# (Tus integraciones > Credenciales de prueba). Empieza con APP_USR- o TEST-
MP_ACCESS_TOKEN=

# Mail de confirmación (Gmail con "Contraseña de aplicación", requiere 2FA activado)
MAIL_USER=
MAIL_APP_PASSWORD=
